# 统一换行符处理
* text=auto

# Shell 脚本必须保持 LF，否则在 Linux / WSL 上会报
#   bash: $'\r': command not found
*.sh text eol=lf

*.js  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf

# Windows 批处理与 PowerShell 保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.blend binary
